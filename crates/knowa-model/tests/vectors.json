{
  "_comment": "Knowa conformance vectors. Generated by an independent Python oracle (json/hashlib/base64/datetime, Ed25519 via cryptography and PyNaCl, cross-checked). A change here is a format change.",
  "jcs": [
    {
      "name": "key order is by UTF-16 code unit (= byte order for ASCII)",
      "input": "{\"b\":1,\"a\":2,\"A\":3,\"_\":4,\"1\":5,\"aa\":6,\"\":7,\"~\":8}",
      "canonical": "{\"\":7,\"1\":5,\"A\":3,\"_\":4,\"a\":2,\"aa\":6,\"b\":1,\"~\":8}"
    },
    {
      "name": "nested objects and arrays sort recursively; arrays keep order",
      "input": "{\"z\":{\"y\":[3,{\"b\":true,\"a\":null}],\"x\":\"s\"},\"a\":[],\"m\":{}}",
      "canonical": "{\"a\":[],\"m\":{},\"z\":{\"x\":\"s\",\"y\":[3,{\"a\":null,\"b\":true}]}}"
    },
    {
      "name": "whitespace is removed",
      "input": " { \"a\" : [ 1 , 2 ] ,\n\t\"b\" : { } } ",
      "canonical": "{\"a\":[1,2],\"b\":{}}"
    },
    {
      "name": "control characters: short forms and lowercase \\u00xx",
      "input": "\"\\u0000\\u0001\\b\\t\\n\\u000b\\f\\r\\u000e\\u001f\"",
      "canonical": "\"\\u0000\\u0001\\b\\t\\n\\u000b\\f\\r\\u000e\\u001f\""
    },
    {
      "name": "quote and backslash escaped; slash, DEL, U+2028/2029 verbatim",
      "input": "\"\\\" \\\\ \\/ / \\u007f \\u2028 \\u2029\"",
      "canonical": "\"\\\" \\\\ / /     \""
    },
    {
      "name": "non-ASCII verbatim as UTF-8, incl. astral plane",
      "input": "{\"text\":\"日本語 café \\ud83d\\ude00 😀\"}",
      "canonical": "{\"text\":\"日本語 café 😀 😀\"}"
    },
    {
      "name": "integers at the safe limits",
      "input": "[0,-1,1,9007199254740991,-9007199254740991]",
      "canonical": "[0,-1,1,9007199254740991,-9007199254740991]"
    },
    {
      "name": "literals",
      "input": "[true,false,null]",
      "canonical": "[true,false,null]"
    }
